# Copia este archivo como `.env` y rellena los valores.
# `.env` está en .gitignore — nunca se sube al repo.

# MySQL 8 (o DATABASE_URL=mysql://user:pass@host:3306/spentry)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=spentry

# Firma de la cookie de sesión (cadena larga y aleatoria)
SESSION_SECRET=
ORIGIN=http://localhost:3040

# Web Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:noreply@acmsy.com
CRON_SECRET=

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cuenta demo local (npm run db:demo)
DEMO_PASSWORD=
